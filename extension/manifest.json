{
  "manifest_version": 3,
  "name": "2password",
  "version": "0.2.0",
  "description": "2password デスクトップアプリと連携して、ログイン画面への自動入力と、ログイン情報の保存を行います。",
  "key": "",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "2password",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["nativeMessaging", "storage", "activeTab"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
