{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "2password",
  "version": "0.6.0",
  "identifier": "dev.twopassword.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "2password",
        "width": 1040,
        "height": 700,
        "minWidth": 760,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Google Drive に暗号文だけを置くパスワード保管庫",
    "longDescription": "1Password の安全設計（アカウントパスワード＋Secret Key）を学習用に再現したパスワード保管庫。保存データは端末で暗号化され、Google Drive には暗号文だけが置かれます。",
    "copyright": "Copyright 2026 AIGYM Inc.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Japanese", "English"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
